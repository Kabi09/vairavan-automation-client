# Server Configuration
PORT=5000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vairavan_duty_management?retryWrites=true&w=majority

# JWT Secrets and Expiration
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins for production)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10

# Cloudflare R2 Storage (AWS S3-Compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# Duty Policy Configuration
REQUIRE_DUTY_LOCATION=false
ALLOW_OVERNIGHT_DUTY=false

# Firebase Admin SDK Configuration (Optional Push Notifications)
# Option 1: Inline JSON string of the Firebase service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2: Path to the service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=

# Initial Admin Bootstrap (Used by npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@vairavan.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_PHONE=+919876543210
ADMIN_EMPLOYEE_ID=ADM001
ADMIN_DESIGNATION=System Administrator
