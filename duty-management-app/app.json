{
  "expo": {
    "name": "VairaWorks",
    "slug": "viraworks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0F52BA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vairavan.dutymanagement",
      "infoPlist": {
        "NSCameraUsageDescription": "VairaWorks requires camera access to capture customer site proof photos.",
        "NSPhotoLibraryUsageDescription": "VairaWorks requires photo library access to upload site visit photos.",
        "NSLocationWhenInUseUsageDescription": "VairaWorks requires location access to record GPS coordinates at the customer service location."
      }
    },
    "android": {
      "package": "com.vairavan.dutymanagement",
       "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#cbe6f3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VairaWorks requires location access to record GPS coordinates at the customer service location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VairaWorks requires access to photos to upload site visit photos.",
          "cameraPermission": "VairaWorks requires camera access to capture site visit photos."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F52BA"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ff8c1225-7ed8-47ee-ab46-9196bd0e21b8"
      }
    }
  }
}
